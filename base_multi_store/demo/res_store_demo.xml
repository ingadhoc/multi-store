<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="main_company_stores" model="res.store">
        <field name="name">Your Company Stores</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="rosario_store" model="res.store">
        <field name="name">Rosario</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="buenos_aires_store" model="res.store">
        <field name="name">Buenos Aires</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="jonas_store" model="res.store">
        <field name="name">Jonas</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- TODO tenemos que ver uso de este store y el "you company stores"
    porque con la nueva demo data de journals y stores a/b
    si los usuarios no tienen el store correspondiente no van a ver nada.
    Ahora como está si porque estamos dando por defecto "shared_store" -->
    <record id="shared_store" model="res.store">
        <field name="name">Shared Store (No company)</field>
    </record>

    <!-- we add demo stores to admin user -->
    <record id="base.user_admin" model="res.users">
        <field name="store_id" ref="shared_store"/>
        <field name="store_ids" eval="[
        (4, ref('main_company_stores')),
        (4, ref('rosario_store')),
        (4, ref('buenos_aires_store')),
        (4, ref('jonas_store')),
        (4, ref('shared_store'))
        ]"/>
    </record>

    <!-- we add demo stores and store group to demo user -->
    <record id="base.user_demo" model="res.users">
        <field name="store_id" ref="shared_store"/>
        <field name="store_ids" eval="[
        (4, ref('main_company_stores')),
        (4, ref('rosario_store')),
        (4, ref('buenos_aires_store')),
        (4, ref('jonas_store')),
        (4, ref('shared_store'))
        ]"/>
        <field name="group_ids" eval="[(4, ref('group_multi_store'))]"/>
    </record>

</odoo>
